<Window x:Class="MeetingRecorder.TranscriptionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Live Transcript" 
        Height="360" Width="460"
        MinHeight="250" MinWidth="350"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="{Binding IsPinned}"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Opacity="0.95">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border Background="#CC1A1A2E" 
            CornerRadius="8" 
            BorderBrush="#40FFFFFF" 
            BorderThickness="1" 
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.3" Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar (Draggable) -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Live Transcript" Foreground="#CCFFFFFF" FontSize="12" FontWeight="SemiBold" Margin="10,6,0,6" VerticalAlignment="Center"/>
                
                <!-- Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,6,0">
                    <Button Command="{Binding ToggleAiCommand}" Background="Transparent" BorderThickness="0" Width="24" Height="24" ToolTip="{Binding ToggleAiButtonTooltip}" Cursor="Hand">
                        <TextBlock Text="✨" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Opacity" Value="0.9"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAiActive}" Value="False">
                                            <Setter Property="Opacity" Value="0.3"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Command="{Binding TogglePinCommand}" Background="Transparent" BorderThickness="0" Foreground="#AAFFFFFF" Width="24" Height="24" ToolTip="Toggle Always On Top">
                        <Button.Content>
                            <Path Data="M 7,2 L 7,6 L 4,9 L 4,11 L 6.5,11 L 6.5,15 L 7.5,15 L 7.5,11 L 10,11 L 10,9 L 7,6 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Margin="4"/>
                        </Button.Content>
                    </Button>
                    <Button Command="{Binding CloseCommand}" Background="Transparent" BorderThickness="0" Foreground="#AAFFFFFF" Width="24" Height="24" ToolTip="Close Overlay">
                        <Path Data="M 2,2 L 10,10 M 10,2 L 2,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform" Margin="6"/>
                    </Button>
                </StackPanel>
            </Grid>
            
            <Border Grid.Row="0" BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>

            <!-- Transcript Scroll Area -->
            <ScrollViewer x:Name="TranscriptScrollViewer" Grid.Row="1" Margin="10,5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Segments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Start, StringFormat={}{0:hh\\:mm\\:ss}}" Foreground="#88FFFFFF" FontSize="10" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding Text}" Foreground="White" FontSize="14" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Real-time live streaming text preview -->
                    <Border Margin="0,4" Visibility="{Binding HasLiveText, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding CurrentLiveText}" Foreground="#B0E0E6" FontStyle="Italic" FontSize="14" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- AI Mention Insight Panel -->
            <Border Grid.Row="2" 
                    Margin="8,4,8,6" 
                    Padding="10,8" 
                    Background="#F01E1F38" 
                    BorderBrush="#FFD97706" 
                    BorderThickness="1.5" 
                    CornerRadius="6"
                    Visibility="{Binding IsInsightVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💡" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="You were mentioned" Foreground="#FBBF24" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Command="{Binding DismissInsightCommand}" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                Foreground="#99FFFFFF" 
                                Width="18" Height="18" 
                                ToolTip="Dismiss Insight"
                                Cursor="Hand">
                            <Path Data="M 2,2 L 8,8 M 8,2 L 2,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform" Margin="2"/>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="1" 
                               Text="{Binding InsightText}" 
                               Foreground="#FFFFFF" 
                               FontSize="13" 
                               FontWeight="Medium" 
                               TextWrapping="Wrap" 
                               LineHeight="18"/>
                </Grid>
            </Border>
            
            <!-- Status Bar -->
            <Border Grid.Row="3" Background="#10FFFFFF" CornerRadius="0,0,7,7">
                <TextBlock Text="{Binding StatusText}" Foreground="#AAFFFFFF" FontSize="11" Margin="10,4" />
            </Border>
        </Grid>
    </Border>
</Window>
